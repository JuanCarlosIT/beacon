{
  "name": "@gab/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test src/modules/application-requests/domain/*.test.js src/modules/application-requests/application/*.test.js tests/*.test.js",
    "format": "prettier --write src tests ../backend/src ../backend/tests ../backend/scripts ../backend/package.json package.json vite.config.js ../package.json ../scripts ../compose.yaml ../README.md ../*.json",
    "format:check": "prettier --check src tests ../backend/src ../backend/tests ../backend/scripts ../backend/package.json package.json vite.config.js ../package.json ../scripts ../compose.yaml ../README.md ../*.json"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sweetalert2": "^11.26.25"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.1.0",
    "prettier": "^3.6.2",
    "vite": "^6.3.5"
  }
}
