// Modelos de Prisma sobre las tablas que crea database/schema.sql.
// El esquema real lo aplica database/schema.sql al arrancar (ensureDatabase); aquí no hay migraciones.
// Si cambia schema.sql: `node scripts/prisma.mjs db pull`, ajustar nombres y `npm run prisma:generate`.
// Las columnas se quedan en snake_case porque así viajan las filas a los servicios y al frontend.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Proveedores aéreos autorizados en la app (el id es el partner de Odoo).
model Supplier {
  odoo_partner_id     Int             @id
  name                String
  authorized          Boolean         @default(false)
  vat                 String          @default("")
  reference           String          @default("")
  registered_at       DateTime?       @db.Timestamptz(6)
  registered_by       String?
  registration_source String?
  requests            Request[]
  events              SupplierEvent[]

  @@map("aerial_suppliers")
}

model SupplierEvent {
  id              BigInt   @id @default(autoincrement())
  odoo_partner_id Int
  actor           String
  description     String
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  supplier        Supplier @relation(fields: [odoo_partner_id], references: [odoo_partner_id], onDelete: NoAction, onUpdate: NoAction)

  @@map("aerial_supplier_events")
}

model ApplicationPeriod {
  code     String    @id
  name     String
  requests Request[]

  @@map("aerial_application_periods")
}

/// Solicitud de aplicación aérea.
model Request {
  id                      String              @id @db.Uuid
  number                  BigInt              @unique @default(autoincrement())
  requested_date          DateTime            @db.Date
  ranch                   String
  lot                     String
  crop                    String
  hectares                Decimal             @db.Decimal(12, 2)
  treatment               String
  priority                String
  notes                   String              @default("")
  status                  String              @default("Solicitada")
  requested_by            String
  created_at              DateTime            @default(now()) @db.Timestamptz(6)
  odoo_plot_id            Int?
  odoo_plot_name_id       Int?
  odoo_zone_id            Int?
  odoo_crop_id            Int?
  odoo_cycle_id           Int?
  cycle_name              String?
  odoo_catalog_snapshot   Json?
  submission_key          String?             @unique(map: "aerial_requests_submission_key_uidx") @db.Uuid
  odoo_supplier_id        Int?
  application_period_code String?
  rate_per_hectare        Decimal?            @db.Decimal(12, 2)
  supplier                Supplier?           @relation(fields: [odoo_supplier_id], references: [odoo_partner_id], onDelete: NoAction, onUpdate: NoAction)
  period                  ApplicationPeriod?  @relation(fields: [application_period_code], references: [code], onDelete: NoAction, onUpdate: NoAction)
  purchaseLink            PurchaseLink?
  execution               Execution?
  attachments             Attachment[]
  events                  Event[]
  challenges              ApprovalChallenge[]
  whatsappDecisions       WhatsappDecision[]

  @@map("aerial_requests")
}

model Execution {
  id             String   @id @db.Uuid
  request_id     String   @unique @db.Uuid
  execution_date DateTime @db.Date
  hectares       Decimal  @db.Decimal(12, 2)
  provider       String
  pilot          String
  cost           Decimal  @db.Decimal(14, 2)
  notes          String   @default("")
  registered_by  String
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  request        Request  @relation(fields: [request_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("aerial_executions")
}

model Attachment {
  id            String   @id @db.Uuid
  request_id    String   @db.Uuid
  original_name String
  stored_name   String
  mime_type     String
  size          Int
  uploaded_by   String
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  request       Request  @relation(fields: [request_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("aerial_attachments")
}

/// Bitácora de la solicitud.
model Event {
  id          BigInt   @id @default(autoincrement())
  request_id  String   @db.Uuid
  actor       String
  description String
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  request     Request  @relation(fields: [request_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("aerial_events")
}

/// Vínculo con la OCM en STAG (status: creating, uncertain, created).
model PurchaseLink {
  request_id      String   @id @db.Uuid
  environment     String   @default("staging")
  database_name   String
  attempt_key     String   @db.Uuid
  status          String
  order_id        Int?
  order_name      String?
  review_required Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)
  request         Request  @relation(fields: [request_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([database_name, order_id])
  @@map("aerial_purchase_links")
}

/// Quienes reciben el aviso por WhatsApp.
model Approver {
  id             BigInt              @id @default(autoincrement())
  name           String
  phone_last10   String
  active         Boolean             @default(true)
  registered_by  String
  created_at     DateTime            @default(now()) @db.Timestamptz(6)
  deactivated_at DateTime?           @db.Timestamptz(6)
  challenges     ApprovalChallenge[]
  decisions      WhatsappDecision[]

  @@map("aerial_approvers")
}

model ApprovalChallenge {
  id              String    @id @db.Uuid
  request_id      String    @db.Uuid
  approver_id     BigInt
  code_hash       String
  status          String    @default("pending")
  failed_attempts Int       @default(0)
  expires_at      DateTime  @db.Timestamptz(6)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  closed_at       DateTime? @db.Timestamptz(6)
  approver        Approver  @relation(fields: [approver_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  request         Request   @relation(fields: [request_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("aerial_approval_challenges")
}

model WhatsappDecision {
  message_id    String    @id
  request_id    String?   @db.Uuid
  approver_id   BigInt?
  sender_last10 String
  command       String
  outcome       String
  reply         String
  received_at   DateTime  @db.Timestamptz(6)
  processed_at  DateTime  @default(now()) @db.Timestamptz(6)
  approver      Approver? @relation(fields: [approver_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  request       Request?  @relation(fields: [request_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("aerial_whatsapp_decisions")
}
