PORT=3001
# Solo en localhost: sesión ficticia del solicitante. Desactivar al integrar el layout real.
IMPLICIT_DEMO_AUTH=true
# Solo pruebas locales: deja que el aprobador de prueba apruebe/rechace (marcado «(prueba)»).
DEMO_APROBAR=false
DB_HOST=127.0.0.1
DB_PORT=5434
POSTGRES_LOCAL_PORT=5434
DB_NAME=fumigaciones_pruebas
DB_USER=fumigaciones_app
DB_PASSWORD=
# Genera un valor aleatorio para conservar las sesiones entre reinicios.
SESSION_SECRET=
# Odoo producción: solo lectura de catálogos. Nunca se envían estas claves al navegador.
ODOO_URL=https://grupo-gab.odoo.com
ODOO_DB=grupo-gab-prod-13871052
ODOO_USER=
ODOO_API_KEY=

# OCM: solo borradores en una rama STAG de Odoo. Nunca usar producción aquí.
ODOO_STAGING_OCM_ENABLED=false
ODOO_STAGING_URL=
ODOO_STAGING_DB=
ODOO_STAGING_USER=
ODOO_STAGING_API_KEY=

# Aviso de aprobación por WhatsApp vía n8n (AgricolaBot): texto con link + PDF. Solo informa;
# aprobar se hace en la app. La app llama a n8n; n8n nunca llama a esta PC. URL = solo el origen HTTPS.
N8N_APPROVALS_ENABLED=false
N8N_APPROVALS_URL=
# Token compartido de al menos 32 caracteres (se manda en el encabezado X-GAB-Token).
N8N_APPROVALS_TOKEN=
# Dirección de la app que va en el link del aviso (por defecto http://127.0.0.1:5173).
# WhatsApp solo marca como link direcciones con dominio. Para abrir desde cualquier equipo de la red usa
# aereas.<IP con guiones>.sslip.io (resuelve a esa IP), p. ej. https://aereas.192-168-1-172.sslip.io:5173 (https con frontend/scripts/crear-certificado.sh).
# Solo en esta PC: http://aereas.localtest.me:5173 (apunta a 127.0.0.1).
APP_PUBLIC_URL=https://aereas.192-168-1-172.sslip.io:5173
